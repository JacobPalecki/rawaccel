<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:userinterface.ViewModels.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="80"
             x:Class="userinterface.Views.Controls.LUTPointCardView"
             x:DataType="vm:LUTPointCardViewModel">

  <UserControl.Styles>
    <Style Selector="Border.point-card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Border.point-card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>

    <Style Selector="TextBlock.point-header">
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style Selector="NumericUpDown.coordinate-input">
      <Setter Property="Width" Value="80"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="ShowButtonSpinner" Value="False"/>
      <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>

    <Style Selector="NumericUpDown.coordinate-input:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>

    <Style Selector="Button.delete-button">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.delete-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
    </Style>

    <Style Selector="PathIcon.delete-icon">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Foreground" Value="{DynamicResource DangerButtonBrush}"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="point-card" Padding="12">
    <Grid ColumnDefinitions="*,Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
      
      <!-- Header -->
      <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5"
                 Text="{Binding PointIndex, StringFormat='Point {0}'}"
                 Classes="point-header"
                 Margin="0,0,0,8"/>
      
      <!-- Input Fields -->
      <TextBlock Grid.Column="0" Grid.Row="1" 
                 Text="X:" 
                 Classes="field-label"/>
      
      <NumericUpDown Grid.Column="1" Grid.Row="1"
                     Value="{Binding XValue}"
                     Minimum="0"
                     Maximum="10000"
                     Increment="1"
                     Classes="coordinate-input"
                     ToolTip.Tip="Mouse speed"
                     Margin="0,0,16,0"/>
      
      <TextBlock Grid.Column="2" Grid.Row="1" 
                 Text="Y:" 
                 Classes="field-label"/>
      
      <NumericUpDown Grid.Column="3" Grid.Row="1"
                     Value="{Binding YValue}"
                     Minimum="0" 
                     Maximum="100"
                     Increment="0.1"
                     FormatString="F2"
                     Classes="coordinate-input"
                     ToolTip.Tip="Output value"
                     Margin="0,0,16,0"/>
      
      <Button Grid.Column="4" Grid.Row="1"
              Command="{Binding DeletePointCommand}"
              Classes="delete-button"
              ToolTip.Tip="Delete point">
        <PathIcon Data="{StaticResource delete_regular}" 
                  Classes="delete-icon"/>
      </Button>
      
    </Grid>
  </Border>

</UserControl>