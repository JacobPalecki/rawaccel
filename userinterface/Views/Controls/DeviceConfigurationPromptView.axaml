<UserControl x:Class="userinterface.Views.Controls.DeviceConfigurationPromptView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ext="using:userinterface.Extensions"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300">

	<UserControl.Styles>
		<Style Selector="Border.ModalContainer">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Padding" Value="24"/>
			<Setter Property="MinWidth" Value="450"/>
			<Setter Property="MinHeight" Value="200"/>
			<Setter Property="CornerRadius" Value="12"/>
		</Style>

		<Style Selector="TextBlock.ModalTitle">
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="Margin" Value="0,0,0,16"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<Style Selector="TextBlock.ModalMessage">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
			<Setter Property="Margin" Value="0,0,0,24"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="TextAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.ModalButton">
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Padding" Value="16,10"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="MinWidth" Value="100"/>
		</Style>

		<Style Selector="Button.ModalButton.Cancel">
			<Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
		</Style>

		<Style Selector="Button.ModalButton.Cancel:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		</Style>

		<Style Selector="Button.ModalButton.Confirm">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
		</Style>

		<Style Selector="Button.ModalButton.Confirm:pointerover">
			<Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
		</Style>

		<Style Selector="StackPanel.ModalButtons">
			<Setter Property="Orientation" Value="Horizontal"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="Spacing" Value="12"/>
		</Style>
	</UserControl.Styles>

	<Border Classes="ModalContainer">
		<Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
			<!-- Header -->
			<TextBlock Grid.Row="0"
			           Classes="ModalTitle"
			           Text="{ext:Localized UnconfiguredDeviceTitle}"/>

			<!-- Icon -->
			<Image Grid.Row="1"
			       Source="/Assets/mouse.ico"
			       Width="48" Height="48"
			       HorizontalAlignment="Center"
			       Margin="0,0,0,16"/>

			<!-- Message -->
			<TextBlock Grid.Row="2"
			           x:Name="MessageTextBlock"
			           Classes="ModalMessage"/>

			<!-- Buttons -->
			<StackPanel Grid.Row="4"
			            Classes="ModalButtons">
				<Button x:Name="CancelButton"
				        Content="{ext:Localized UnconfiguredDeviceCancelButton}"
				        Classes="ModalButton Cancel"
				        Click="OnCancelClicked"/>
				<Button x:Name="CreateButton"
				        Content="{ext:Localized UnconfiguredDeviceCreateButton}"
				        Classes="ModalButton Confirm"
				        Click="OnCreateClicked"/>
			</StackPanel>
		</Grid>
	</Border>
</UserControl>