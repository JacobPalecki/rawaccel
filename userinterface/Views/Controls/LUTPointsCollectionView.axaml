<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:userinterface.ViewModels.Controls"
             xmlns:views="using:userinterface.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="600"
             x:Class="userinterface.Views.Controls.LUTPointsCollectionView"
             x:DataType="vm:LUTPointsCollectionViewModel">

  <UserControl.Styles>
    <Style Selector="Button.add-point-button">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.add-point-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}"/>
    </Style>

    <Style Selector="Button.add-point-button:pressed">
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBrush}"/>
    </Style>

    <Style Selector="Button.secondary-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.secondary-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}"/>
    </Style>

    <Style Selector="TextBlock.point-count">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontStyle" Value="Italic"/>
    </Style>
    
    <Style Selector="Button.carousel-nav-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
    </Style>
    
    <Style Selector="Button.carousel-nav-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonBrush}"/>
    </Style>
    
    <Style Selector="Button.carousel-nav-button:disabled">
      <Setter Property="Opacity" Value="0.3"/>
    </Style>
    
    <Style Selector="TextBlock.empty-state-text">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontStyle" Value="Italic"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    
    <!-- Add Point Button -->
    <Button Grid.Row="0"
            Command="{Binding AddPointCommand}"
            Classes="add-point-button"
            IsEnabled="{Binding CanAddPoints}"
            Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="+" FontWeight="Bold" FontSize="16"/>
        <TextBlock Text="Add Point"/>
      </StackPanel>
    </Button>
    
    <!-- Carousel Container -->
    <Grid Grid.Row="1" Height="160">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      
      <!-- Previous Button -->
      <Button Grid.Row="0"
              Command="{Binding NavigatePreviousCommand}"
              IsEnabled="{Binding CanNavigatePrevious}"
              Classes="carousel-nav-button"
              HorizontalAlignment="Center"
              Margin="0,0,0,8">
        <PathIcon Data="{StaticResource chevron_up_regular}" 
                  Width="16" Height="16"/>
      </Button>
      
      <!-- Cards Display Area -->
      <Grid Grid.Row="1">
        <!-- Previous Card (faded) -->
        <ContentControl Content="{Binding PreviousPoint}"
                        IsVisible="{Binding PreviousPoint, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Opacity="0.3"
                        IsHitTestVisible="False"
                        ZIndex="1">
          <ContentControl.RenderTransform>
            <TranslateTransform Y="-40"/>
          </ContentControl.RenderTransform>
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:LUTPointCardViewModel">
              <views:LUTPointCardView/>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        
        <!-- Current Card (active) -->
        <ContentControl Content="{Binding CurrentPoint}"
                        IsVisible="{Binding CurrentPoint, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Opacity="1.0"
                        ZIndex="2">
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:LUTPointCardViewModel">
              <views:LUTPointCardView/>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        
        <!-- Next Card (faded) -->
        <ContentControl Content="{Binding NextPoint}"
                        IsVisible="{Binding NextPoint, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Opacity="0.3"
                        IsHitTestVisible="False"
                        ZIndex="1">
          <ContentControl.RenderTransform>
            <TranslateTransform Y="40"/>
          </ContentControl.RenderTransform>
          <ContentControl.ContentTemplate>
            <DataTemplate DataType="vm:LUTPointCardViewModel">
              <views:LUTPointCardView/>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
        
        <!-- Empty State Message -->
        <TextBlock Text="No points added yet. Click 'Add Point' to start."
                   IsVisible="{Binding !HasPoints}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Classes="empty-state-text"/>
      </Grid>
      
      <!-- Next Button -->
      <Button Grid.Row="2"
              Command="{Binding NavigateNextCommand}"
              IsEnabled="{Binding CanNavigateNext}"
              Classes="carousel-nav-button"
              HorizontalAlignment="Center"
              Margin="0,8,0,0">
        <PathIcon Data="{StaticResource chevron_down_regular}" 
                  Width="16" Height="16"/>
      </Button>
    </Grid>
    
    <!-- Actions Bar -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal" 
                Spacing="12"
                IsVisible="{Binding HasPoints}"
                Margin="0,12,0,0">
      
      <Button Command="{Binding ClearAllPointsCommand}" 
              Classes="secondary-button">
        Clear All
      </Button>
      
      <TextBlock Text="{Binding Points.Count, StringFormat={}{0} points}"
                 VerticalAlignment="Center"
                 Classes="point-count"/>
      
    </StackPanel>
    
  </Grid>

</UserControl>